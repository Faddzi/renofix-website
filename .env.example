# Get in Touch form (src/app/api/enquiry/route.ts). Copy to .env.local and fill in.
# API key from https://resend.com, for a domain verified there (renofix.in).
RESEND_API_KEY=
# Sender address on the verified domain.
RESEND_FROM="Renofix website <website@renofix.in>"
# Where enquiries go. Defaults to hello@renofix.in.
ENQUIRY_TO=hello@renofix.in
